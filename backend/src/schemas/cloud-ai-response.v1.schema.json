{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloud-ai-response.v1",
  "title": "Cloud AI Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "summary",
    "suggestions",
    "recommendedFilters",
    "generatedFilter",
    "poseGuide",
    "retakeAdvice",
    "cropAdvice",
    "confidence",
    "source",
    "locale",
    "safety",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "post_capture",
        "pre_capture",
        "filter_recommendation",
        "filter_generation",
        "inspiration",
        "pose_guide",
        "unavailable",
        "error"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 280
    },
    "suggestions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text", "priority", "action"],
        "properties": {
          "type": {
            "enum": ["filter", "crop", "lighting", "retake", "composition"]
          },
          "text": {
            "type": "string",
            "maxLength": 180
          },
          "priority": {
            "enum": ["low", "medium", "high"]
          },
          "action": {
            "enum": ["apply_filter", "adjust_crop", "retake", "none"]
          }
        }
      }
    },
    "recommendedFilters": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filterId", "reason", "confidence"],
        "properties": {
          "filterId": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "maxLength": 140
          },
          "confidence": {
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "generatedFilter": {
      "type": ["object", "null"]
    },
    "poseGuide": {
      "type": ["object", "null"]
    },
    "retakeAdvice": {
      "type": ["object", "null"]
    },
    "cropAdvice": {
      "type": ["object", "null"]
    },
    "confidence": {
      "enum": ["low", "medium", "high"]
    },
    "source": {
      "enum": ["mock", "local", "cloud", "fallback"]
    },
    "locale": {
      "type": "string"
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsSensitiveInference", "requiresUserConsent", "blockedReason"],
      "properties": {
        "containsSensitiveInference": {
          "const": false
        },
        "requiresUserConsent": {
          "type": "boolean"
        },
        "blockedReason": {
          "type": ["string", "null"]
        }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message", "recoverable"],
      "properties": {
        "code": {
          "enum": [
            "network_unavailable",
            "timeout",
            "quota_exceeded",
            "provider_error",
            "invalid_json",
            "invalid_schema",
            "unsafe_response",
            "image_too_large",
            "user_cancelled",
            "consent_declined",
            "unsupported_image",
            "backend_unavailable",
            "invalid_request",
            "rate_limited",
            "provider_unavailable",
            "provider_timeout",
            "provider_invalid_json",
            "provider_invalid_schema",
            "missing_consent",
            "internal_cloud_disabled"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 180
        },
        "recoverable": {
          "type": "boolean"
        }
      }
    }
  }
}
