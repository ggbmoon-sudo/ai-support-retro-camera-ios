{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "photo-advisor-request.v1",
  "title": "Photo Advisor Request v1",
  "type": "object",
  "required": ["schemaVersion", "mode", "consent"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "mode": {
      "const": "post_capture"
    },
    "locale": {
      "type": "string"
    },
    "selectedFilterId": {
      "type": ["string", "null"]
    },
    "consent": {
      "type": "object",
      "required": ["imageUploadAccepted", "consentVersion"],
      "properties": {
        "imageUploadAccepted": {
          "const": true
        },
        "consentVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["contentType", "width", "height", "metadataStripped"],
      "properties": {
        "contentType": {
          "const": "image/jpeg"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "metadataStripped": {
          "const": true
        },
        "dataBase64": {
          "type": "string",
          "maxLength": 96000
        }
      }
    }
  }
}
