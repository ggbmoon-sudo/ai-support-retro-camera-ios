"advisor.intent.signal.blur.en" = "The softness can read as dreamy retro texture. For a cleaner look, take another only if you want clearer detail.";
"advisor.intent.signal.motion.en" = "The slight motion gives this a candid film feel. For a cleaner version, hold steady and take one more.";
"advisor.intent.signal.low_light.en" = "The shadows can stay for the night mood; brighten slightly only if you want more detail.";
"advisor.intent.signal.tilt.en" = "The tilt gives it snapshot energy. Straighten only if you want a quieter frame.";
"advisor.intent.signal.grain.en" = "A little grain makes the film mood clearer. Keep it, or soften the filter for a cleaner version.";
"advisor.intent.signal.soft_focus.en" = "The soft focus gives the frame a dreamy retro mood. For clearer detail, lock focus next time.";
"advisor.intent.signal.overexposure.en" = "The bright highlights can feel like light leak or summer glare. Lower them slightly only if you want more detail.";
"advisor.intent.signal.underexposure.en" = "The darker exposure gives the frame a quiet shadow mood. Lift it slightly only if you want more detail.";
"advisor.intent.signal.high_contrast.en" = "The stronger contrast gives the frame more street-film weight. A softer filter is optional if you want more detail.";
"advisor.intent.signal.faded_color.en" = "The muted color feels like worn film. Pair it with a faded or pastel filter.";
"advisor.intent.signal.unusual_framing.en" = "The unusual framing can feel intentional. Keep the breathing room, or crop lightly for a cleaner version.";
"advisor.intent.signal.clutter.en" = "The busy details can support a street snapshot feel. Crop lightly only if they pull too much attention.";
"advisor.intent.signal.crop_risk.en" = "A small crop can guide attention, but keep the loose snapshot feel if that is the mood.";
"advisor.action.retake.technical_risk.en" = "Keep this one for the mood; take another only if the visual detail is too hard to read.";

"advisor.intent.signal.blur.zh_hant" = "柔焦感可以保留，會有夢幻復古質感；想更清晰才再拍一張。";
