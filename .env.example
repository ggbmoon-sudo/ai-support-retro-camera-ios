# Do not put real secrets in this file.

QWE_API_KEY=replace_me
QWE_BASE_URL=https://qweapi.com
QWE_PHOTO_ADVISOR_MODEL=gemini-3.1-flash-image-preview

SILICONFLOW_API_KEY=replace_me
SILICONFLOW_BASE_URL=https://api.siliconflow.com
SILICONFLOW_CHAT_COMPLETIONS_PATH=/v1/chat/completions
SILICONFLOW_PHOTO_ADVISOR_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_FILTER_LAB_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Backend-only internal/debug Xiaoyi candidate. Keep the real key untracked.
XIAOYI_API_KEY=replace_me
# Optional local-development alternative to XIAOYI_API_KEY. The file may contain
# either the raw key or one XIAOYI_API_KEY=... line and must stay outside Git.
XIAOYI_API_KEY_FILE=
XIAOYI_MODEL=gpt-5.6-luna
XIAOYI_PHOTO_ADVISOR_MODEL=gpt-5.6-luna
XIAOYI_FILTER_LAB_MODEL=gpt-5.6-luna
XIAOYI_COMPOSITION_PLANNER_MODEL=gpt-5.6-luna
# Set CLOUD_AI_PROVIDER_MODE=xiaoyiLunaInternal only for an approved backend internal/debug run.
CLOUD_AI_PROVIDER_MODE=mock
ALLOW_INTERNAL_CLOUD_AI=false
FILTER_LAB_SAVE_SANITIZED_ANALYSIS=false
